# --- Proxmox Host 1 (Standalone colossus) ---
pve_host_1_endpoint  = "https://colossus.jnet.lan:8006/"
pve_host_1_api_token = "terraform-ci@pve!gitlab-runner=00000000-0000-0000-0000-000000000000"
pve_host_1_node_name = "colossus"

# --- Proxmox Host 2 (Standalone guardian) ---
pve_host_2_endpoint  = "https://guardian.jnet.lan:8006/"
pve_host_2_api_token = "terraform-ci@pve!gitlab-runner=00000000-0000-0000-0000-000000000000"
pve_host_2_node_name = "guardian"

proxmox_insecure = true

# Storage Pools
storage_datastore = "local-lvm"
snippet_datastore = "local"

# Networking
network_bridge  = "vmbr0"
network_gateway = "192.169.0.1"
dns_servers     = ["192.169.0.1", "1.1.1.1"]

# SSH Key for authentication
ssh_public_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGitlabRunnerKeyHereSamplePublicVaultAccess root@gitlab"
]

# VM Template (AlmaLinux 9 CIS Level 2)
template_vm_id = 1000
ci_user        = "almalinux"

# Resource Sizing
vault_vm_config = {
  cores     = 2
  memory    = 4096
  disk_size = 32
}

vault_lxc_config = {
  cores     = 1
  memory    = 1024
  disk_size = 8
}

lxc_template_path = "local:vztmpl/almalinux-9-default_latest.tar.xz"

# Node IP and Host Allocation
host1_vms = {
  "vm-vault-01" = {
    vmid        = 501
    ip_cidr     = "192.169.0.201/24"
    description = "Main Vault Cluster Node 01 (Raft - colossus)"
  }
  "vm-vault-02" = {
    vmid        = 502
    ip_cidr     = "192.169.0.202/24"
    description = "Main Vault Cluster Node 02 (Raft - colossus)"
  }
}

host2_vms = {
  "vm-vault-03" = {
    vmid        = 503
    ip_cidr     = "192.169.0.203/24"
    description = "Main Vault Cluster Node 03 (Raft - guardian)"
  }
}

host2_lxcs = {
  "vm-vault-transit" = {
    vmid        = 500
    ip_cidr     = "192.169.0.200/24"
    description = "Isolated Transit Vault LXC (Auto-Unseal Engine - guardian)"
  }
}
